<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service web.config for Node.js + Socket.IO
  Enables WebSocket upgrade pass-through via IIS ARR proxy
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Socket.IO long-polling + WebSocket upgrade -->
        <rule name="SocketIO" patternSyntax="ECMAScript">
          <match url="socket.io(.*)"/>
          <action type="Rewrite" url="src/server.js"/>
        </rule>
        <!-- API routes -->
        <rule name="API" patternSyntax="ECMAScript">
          <match url="api(.*)"/>
          <action type="Rewrite" url="src/server.js"/>
        </rule>
        <!-- Everything else -->
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}"/>
        </rule>
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True"/>
          </conditions>
          <action type="Rewrite" url="src/server.js"/>
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <remove segment="bin"/>
        </hiddenSegments>
      </requestFiltering>
    </security>
    <serverRuntime uploadReadAheadSize="52428800" />
    <httpErrors existingResponse="PassThrough" />
    <iisnode watchedFiles="web.config;*.js" loggingEnabled="true" />
  </system.webServer>
</configuration>

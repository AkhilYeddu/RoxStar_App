{
  "name": "roxstar-backend",
  "version": "1.0.0",
  "description": "RoxStar Voice Draft, Real-Time Room and Spin Wheel Backend Service",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --runInBand --detectOpenHandles --forceExit --coverage",
    "seed": "node database/seeds/seed.js"
  },
  "keywords": [
    "roxstar",
    "socketio",
    "oboe",
    "spin-wheel",
    "mongodb",
    "realtime"
  ],
  "author": "RoxStar Candidate",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.1",
    "pino": "^8.20.0",
    "pino-pretty": "^11.0.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.8",
    "socket.io-client": "^4.7.5",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "..",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/backend/node_modules"
    ],
    "modulePaths": [
      "<rootDir>/backend/node_modules"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "collectCoverageFrom": [
      "<rootDir>/backend/src/**/*.js",
      "!<rootDir>/backend/src/server.js"
    ]
  }
}

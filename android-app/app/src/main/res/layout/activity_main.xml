<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌟 RoxStar Studio"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1E293B"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="⚡ Offline"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUserInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 User: User_Guest"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Card 1: Voice DSP Studio -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙️ Voice DSP Studio"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etDraftTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0F172A"
                    android:hint="Draft Title (e.g. My Vocal Take)"
                    android:inputType="textNoSuggestions"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select DSP Voice Filter:"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Voice Effect Radio Buttons -->
                <RadioGroup
                    android:id="@+id/rgEffects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbNone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="Clean"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbEcho"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Echo"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbReverb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reverb"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbHelium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Helium 🎈"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbDemonic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Demonic 😈"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </RadioGroup>

                <!-- Recording Status & Timer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvAudioStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ready to record"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvRecordTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00.0"
                        android:textColor="#10B981"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Record Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnRecord"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#EF4444"
                        android:text="🔴 Start Record"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnStopRecord"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#6366F1"
                        android:enabled="false"
                        android:text="⏹ Stop &amp; Save"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved Voice Drafts:"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Container for Draft Cards -->
                <LinearLayout
                    android:id="@+id/llDraftsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Room & Spin Wheel Arena -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎡 Room &amp; Spin Arena"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etRoomInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0F172A"
                    android:hint="Room Name or Room ID"
                    android:inputType="textNoSuggestions"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnCreateRoom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#6366F1"
                        android:text="➕ Create" />

                    <Button
                        android:id="@+id/btnJoinRoom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#0EA5E9"
                        android:text="🚀 Join" />

                    <Button
                        android:id="@+id/btnLeaveRoom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#64748B"
                        android:text="🚪 Leave" />
                </LinearLayout>

                <!-- Active Room Info -->
                <TextView
                    android:id="@+id/tvActiveRoomInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Not in any room. Enter room above to join."
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <!-- Spin Wheel Panel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0F172A"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Status banner + countdown row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tvSpinStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎡 Spin Wheel Status: Ready"
                            android:textColor="#F59E0B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSpinTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏱️ --"
                            android:textColor="#EC4899"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- The visual spin wheel -->
                    <com.roxstar.app.ui.spin.SpinWheelView
                        android:id="@+id/spinWheelView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="8dp" />

                    <!-- Winner overlay card (GONE by default) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvWinnerCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#1A2B1A"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#10B981"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏆 WINNER! 🏆"
                                android:textColor="#F59E0B"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/tvWinnerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎊 Congratulations! 🎊"
                                android:textColor="#10B981"
                                android:textSize="13sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvSurvivors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👥 Contenders: None"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnStartSpin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#F59E0B"
                        android:text="🎡 Start Spin Wheel"
                        android:textColor="#0F172A"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
